classDiagram
  class World {
    +mode: string
    +board: BoardConfig
    +_bmp: Uint8Array
    +_boardW: int
    +_boardH: int
    +victoryLines: VictoryLines
    +victoryThresholds: VictoryThresholds
    +stonesPerTurn: int
    +lonelyDeathDelay: int
    +static SHAPE_OUT: 0
    +static SHAPE_PLAY: 1
    +static SHAPE_VOID: 2
    +static BOARD_MIN: 1
    +static BOARD_MAX: 100
    +static BOARD_PRESETS: object
    +static normBoard(v, mode) BoardConfig
    +static encodeBoard(w, h, grid) string
    +static decodeBoard(cfg) Uint8Array
    +static isWall(bmp, w, h, lx, ly) boolean
    +_isWall(lx, ly) boolean
    +_isPlayable(lx, ly) boolean
    +_genResources()
    +_seedOnboarding(px, py, pid)
    +_lifePlant(p)
    +_lifeStep(events)
    +_captureEnclosed(events)
    +_updateVoronoi(rOverride)
    +_updateRegionControl()
    +_applyTideSpawns(events)
    +_checkVictoryConditions(events)
    +snapshot(includeEntities) object
  }
  class BoardConfig {
    +w: int
    +h: int
    +shape: string
  }
  class GoMixins {
    +_goLiberties(x, y) int
    +_goLoneLiberty(x, y) object
    +_goEvolveOnce(bt)
    +_goEnclosedEmpty() object
    +_goScoreChinese() ChineseScore
    +_goPlayBatch(f, moves, events) object
    +_goFinish(reason, events)
    +_goSnapshotState() object
    +applyGoIntent(playerId, data, events)
  }
  class GoAI {
    +goAIMove(world, f) object
  }
  class Room {
    +code: string
    +mode: string
    +board: BoardConfig
    +victoryLines: VictoryLines
    +victoryThresholds: VictoryThresholds
    +worldId: string
  }
  class roomsRepo {
    +create(code, worldId, ownerId, maxPlayers, opts)
    +get(code)
    +setSettings(code, s)
  }
  class SpawnHelper {
    +pickSpawn(rng, existing, tries, w, h, isValid) array
  }
  World --> BoardConfig
  World --> VictoryLines
  World --> VictoryThresholds
  World ..> GoMixins : installGoMode(World)
  GoMixins ..> World : World.isWall / _isWall
  GoAI ..> World : World.isWall 过滤候选
  World ..> SpawnHelper : pickSpawn(isValid)
  Room --> BoardConfig
  Room ..> World : worldForRoom(norm opts 含 board)
  roomsRepo ..> Room : create / hydrate（board TEXT）
