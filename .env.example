# 复制本文件为 .env 并填写，然后务必确认 .env 已被 git 忽略。
# 注意：服务本身**不会**自动读取 .env。需用以下任一方式让变量生效：
#   1) node --env-file=.env server/index.js   (Node 20.6+)
#   2) 由 systemd / pm2 / Docker 等注入环境变量

PORT=17000

# 必填：否则任何人都能用源码里的默认密钥伪造管理员令牌
JWT_SECRET=

# 可选覆盖（未设时默认 ./server/data/game.db，已持久化）
# DB_PATH=./server/data/game.db

# 部署在可信反向代理后且需要真实来源 IP 时才设
# TRUST_PROXY=1

# 管理后台来源限制（远程管理必设）与访问密钥
# ADMIN_ALLOWED_IPS=127.0.0.1
# ADMIN_ACCESS_KEY=

# 登录即自动授予管理员的用户名，逗号分隔
# ADMIN_USERNAMES=

# 启动时自举的逃生管理员账号
# MASTER_USERNAME=
# MASTER_PASSWORD=
